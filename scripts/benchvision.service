[Unit]
Description=BenchVision Raspberry Pi Video & Motion Magnification Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=video
WorkingDirectory=__APP_DIR__
Environment="BENCHVISION_DATA_DIR=__APP_DIR__/data"
Environment="BENCHVISION_PORT=8000"
ExecStart=__APP_DIR__/.venv/bin/python3 __APP_DIR__/run.py --host 0.0.0.0 --port 8000 --data-dir __APP_DIR__/data
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

